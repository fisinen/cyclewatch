type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type Timestamp = int;
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type MemoryBreakdown = 
 record {
   heapBytes: nat;
   stableBytes: nat;
   wasmBytes: nat;
 };
type ManagedCanister = 
 record {
   addedAt: Timestamp;
   canisterId: CanisterId;
 };
type IcpToCyclesRate = 
 record {
   icpPerXdr: nat;
   updatedAt: Timestamp;
 };
type Cycles = nat;
type Cell = 
 record {
   name: text;
   value: Value;
 };
type CanisterStatusInfo = 
 record {
   canisterId: CanisterId;
   controllers: vec text;
   resources: CanisterResources;
   status: CanisterStatus;
 };
type CanisterStatus = 
 variant {
   running;
   stopped;
   stopping;
   unknown: text;
 };
type CanisterSettings = 
 record {
   computeAllocation: nat;
   freezingThreshold: nat;
   memoryAllocation: nat;
 };
type CanisterResources = 
 record {
   burnRateCyclesPerDay: nat;
   cycleBalance: Cycles;
   memory: MemoryBreakdown;
   runwayDays: nat;
   settings: CanisterSettings;
 };
type CanisterId = principal;
service : {
  addCanister: (canisterId: text) -> ();
  execute: (qJson: text) -> (Result) query;
  getActiveCanister: () -> (opt CanisterId) query;
  getApiDoc: () -> (text) query;
  getBackendCanisterId: () -> (text) query;
  getCanisterCycleBalance: (canisterId: text) ->
   (variant {
      err: text;
      ok: nat;
    });
  getCanisterResources: (canisterId: text) ->
   (variant {
      err: text;
      ok: CanisterResources;
    });
  getCanisterStatus: (canisterId: text) ->
   (variant {
      err: text;
      ok: CanisterStatusInfo;
    });
  getIcpToCyclesRate: () -> (IcpToCyclesRate) query;
  listManagedCanisters: () -> (vec ManagedCanister) query;
  refreshIcpToCyclesRate: () -> (IcpToCyclesRate);
  removeCanister: (canisterId: text) -> ();
  schema: () -> (text) query;
  setActiveCanister: (canisterId: text) -> ();
}
